@unpublished{santander2022school,
  title = {Leaving the Most Vulnerable Behind? School Closures During the COVID-19 Pandemic and Pre-Existing Life Struggles in Bolivia},
  author = {Santander, Sara and Nogales, Ricardo},
  year = {2022},
  note = {Prize in the undergraduate research category, 15th Meeting of Economists, Central Bank of Bolivia},
  abstract = {In this paper, we combine microsimulation and projection methods to assess the short- and mid-term effects of school closures on school unattendance in Bolivia. We show, for instance, that the proportion of people living in households affected by school unattendance may increase from 2.1% to 8.5% if the 10% most vulnerable children end up dropping out due to school closures. We also show that newly acquired school attendance deprivations may be combined with pre-existing life struggles pushing people into multidimensional poverty. If the 10% most vulnerable children drop out of school, the proportion of people living in multidimensionally poor households affected by school unattendance can increase from 1.3% to 7%.},
  selected = {true}
}